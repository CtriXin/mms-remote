{
  "name": "mms-remote",
  "version": "1.7.64",
  "description": "Local bridge between Codex and the MMS Remote mobile app. Run `mms-remote up` to start.",
  "main": "src/index.js",
  "bin": {
    "mms-remote": "./bin/mms-remote.js",
    "mmr": "./bin/mms-remote.js"
  },
  "files": [
    "bin/",
    "scripts/",
    "src/"
  ],
  "scripts": {
    "start": "node ./scripts/start-local.js",
    "restart": "node ./scripts/start-local.js",
    "test": "node --test ./test/*.test.js",
    "postinstall": "node ./src/bootstrap-codex-cli.js",
    "prepack": "node ./scripts/prepare-private-defaults.js",
    "postpack": "node ./scripts/cleanup-private-defaults.js"
  },
  "keywords": [
    "mms-remote",
    "codex",
    "bridge",
    "cli"
  ],
  "author": "MMS Remote contributors",
  "license": "Apache-2.0",
  "type": "commonjs",
  "dependencies": {
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.19.0"
  }
}
